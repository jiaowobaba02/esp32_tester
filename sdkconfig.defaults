CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# DeepSeek 用 TrustAsia CA (esp 证书包不含), 跳过 TLS 证书验证
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
# AI 出题 HTTP/TLS 需要大栈 (main 任务默认 3.5KB 会溢出)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# flash 4MB (分区表含 weakness/favorites)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE=4MB
# 流式响应读块小, TLS 输入缓冲 16KB→8KB 省 ~8KB RAM (AI 请求握手更稳)
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
# 顶栏时间: SNTP 校时 (默认开启, 显式声明防止被裁剪)
CONFIG_LWIP_SNTP=y
